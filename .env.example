# Public Supabase configuration (already used by the app)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only YouTube playlist import
YOUTUBE_API_KEY=

# Server-only maintenance. Never expose these with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=

# Optional Smart Import suggestions (server only). Vercel supplies OIDC.
SMART_IMPORT_AI_ENABLED=false
SMART_IMPORT_AI_MODEL=google/gemini-2.5-flash-lite
AI_GATEWAY_API_KEY=

# Editorial AI. Explicit true/false overrides the Vercel Preview default.
EDITORIAL_AI_ENABLED=false

# Optional X API credential for recent public appearances (server-only).
EDITORIAL_X_BEARER_TOKEN=
