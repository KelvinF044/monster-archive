# Public Supabase configuration (already used by the app)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only YouTube playlist import
YOUTUBE_API_KEY=

# Server-only AI classification. Keep the key as a Vercel Secret.
OPENAI_API_KEY=
# Optional model override; defaults to gpt-6.2-sol.
OPENAI_SMART_IMPORT_MODEL=

# Server-only maintenance. Never expose these with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=
